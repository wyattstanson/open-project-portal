# real secrets (never commit)
.env

# NOTE: portal/data/db.json and portal/data/.vault_key ARE committed on purpose
# for the demo deploy (synthetic data, private repo). With real data, ignore
# them again and set VAULT_KEY as a Render secret instead.

# vercel link for the separate static tool
.vercel
deploy/.vercel

# misc
node_modules
*.log

# generated presentation exports (regenerate with extract-roster.js)
portal/data/students-list.csv
portal/data/faculty-list.csv

# SQLite runtime database (rebuilt from db.json on first boot; the volume keeps it)
portal/data/portal.db
portal/data/portal.db-wal
portal/data/portal.db-shm
