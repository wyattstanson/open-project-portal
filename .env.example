# Copy to .env and fill in for production.

# 64 hex chars = the AES-256 key that encrypts student emails.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this SECRET and STABLE. If it changes, existing encrypted emails cannot be read.
VAULT_KEY=

# Port the portal listens on.
PORT=4000
