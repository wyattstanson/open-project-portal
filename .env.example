# Copy to .env  ->  `cp .env.example .env`  then edit. docker compose reads it automatically.
# Every key has a safe default in docker-compose.yml, so .env is optional for a demo run.

# ---- Postgres (the db service) ----
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal
POSTGRES_DB=portal

# ---- Portal app ----
# Threads for parallel scrypt password hashing under load.
UV_THREADPOOL_SIZE=64
# Node worker processes. KEEP AT 1 — the in-memory cache is not multi-worker safe.
WORKERS=1
# Postgres connection-pool size.
PG_POOL=10
# Hashkeys may only be emailed to addresses on THIS domain (no personal ids).
PROCTOR_EMAIL_DOMAIN=vit.ac.in
# Host port nginx is published on.
HTTP_PORT=80

# ---- Secrets ----
# AES-256 key (64 hex chars) that encrypts student emails. Set this for REAL data and
# keep it SECRET + STABLE (if it changes, existing encrypted emails can't be read).
# Leave EMPTY to use the committed demo key (synthetic data only).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VAULT_KEY=

# DATABASE_URL is assembled by docker-compose from the POSTGRES_* values above, so you
# don't set it here. (Running the app OUTSIDE docker? Set DATABASE_URL yourself to use
# Postgres, or leave it unset to use the built-in SQLite store.)
